@page "/projects/{Id:guid}"
@rendermode InteractiveServer

@using InsulaCalc.Models
@using InsulaCalc.Services
@using Microsoft.JSInterop
@inject ProjectService ProjectService
@inject ProjectPdfService ProjectPdfService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Project Details - InsulaCalc</PageTitle>

<div class="projects-page">

    <header class="projects-header">
        <div class="projects-eyebrow">
            SMART INSULATION PLANNING
        </div>

        <h1>Project Details</h1>
        <p>Manage your project and insulation materials.</p>
    </header>

    @if (project == null)
    {
        <section class="projects-card">
            <h2>Project not found</h2>
            <p>The requested project could not be found.</p>

            <button class="projects-save-button"
                    @onclick="BackToProjects">
                Back to Projects
            </button>
        </section>
    }
    else
    {
        <!-- EDIT PROJECT -->

        <section class="projects-card">

            <div class="projects-card-heading">
                <div class="projects-icon">✎</div>
                <div>
                    <h2>Edit project</h2>
                    <p>Update your project information.</p>
                </div>
            </div>

            <div class="projects-form">

                <label for="editName">Project name</label>
                <input id="editName"
                       class="projects-input"
                       @bind="projectName" />

                <label for="editDescription">Description</label>
                <textarea id="editDescription"
                          class="projects-input projects-textarea"
                          @bind="projectDescription">
                </textarea>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <p class="projects-error">@errorMessage</p>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <p class="project-success">@successMessage</p>
                }

                <div class="project-detail-actions">
                    <button class="projects-save-button"
                            @onclick="UpdateProjectAsync">
                        Save Changes
                    </button>

                    <button class="project-secondary-button"
                            @onclick="BackToProjects">
                        Back to Projects
                    </button>
                </div>
            </div>
        </section>

        <div class="project-detail-actions mb-4">
            <button type="button" class="projects-save-button"
                    @onclick="ExportProjectPdfAsync"
                    disabled="@isExportingPdf">
                @(isExportingPdf ? "Generating PDF..." : "Export to PDF")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(pdfError))
        {
            <p class="projects-error">@pdfError</p>
        }

        <!-- PROJECT SUMMARY -->

        <section class="projects-card project-overview-section">
            <div class="projects-card-heading">
                <div class="projects-icon">▤</div>
                <div>
                    <h2>Project Summary</h2>
                    <p>Combined insulation requirements for this project.</p>
                </div>
            </div>

            <div class="project-overview-grid">
                <div class="project-overview-stat">
                    <span>Materials</span>
                    <strong>@ProjectMaterialCount</strong>
                </div>
                <div class="project-overview-stat">
                    <span>Total length</span>
                    <strong>@TotalMaterialLength.ToString("0.##") m</strong>
                </div>
                <div class="project-overview-stat">
                    <span>Full packages</span>
                    <strong>@TotalMaterialPackages</strong>
                </div>
                <div class="project-overview-stat">
                    <span>Loose sections</span>
                    <strong>@TotalMaterialLooseSections</strong>
                </div>
                <div class="project-overview-stat">
                    <span>Rolls</span>
                    <strong>@TotalMaterialRolls</strong>
                </div>
            </div>

            @if (ProjectMaterialCount > 0)
            {
                <div class="project-type-summary">
                    @foreach (var group in MaterialGroups)
                    {
                        <div class="project-type-summary-row" @key="group.Key">
                            <span>@group.Key</span>
                            <strong>@group.Count() material(s)</strong>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="project-overview-empty">Add materials from a calculator to see your project totals.</p>
            }
        </section>

        <!-- PROJECT MATERIALS -->

        <section class="projects-card">

            <div class="projects-card-heading">
                <div class="projects-icon">▤</div>
                <div>
                    <h2>Project Materials</h2>
                    <p>Materials saved to this project.</p>
                </div>
            </div>

            @if (project.Materials == null ||
                 project.Materials.Count == 0)
            {
                <div class="materials-empty">
                    <h3>No materials added yet</h3>
                    <p>Add your first insulation material below.</p>
                </div>
            }
            else
            {
                <div class="materials-list">
                    @foreach (var group in MaterialGroups)
                    {
                        <div class="project-material-group" @key="group.Key">
                            <div class="project-material-group-heading">
                                <h3>@group.Key</h3>
                                <span>@group.Count() material(s)</span>
                            </div>

                            @foreach (var material in group)
                            {
                                <div class="material-item" @key="material.Id">
                                    <div class="material-content">
                                        <span class="material-type">@material.MaterialType</span>
                                        <h3>@material.Description</h3>
                                        <p>Length: @material.Length.ToString("0.##") m</p>

                                        @if (material.Diameter > 0)
                                        {
                                            <p>Diameter: @material.Diameter mm</p>
                                        }
                                        @if (material.Thickness > 0)
                                        {
                                            <p>Thickness: @material.Thickness mm</p>
                                        }
                                        @if (material.Packages > 0)
                                        {
                                            <p>Packages: @material.Packages</p>
                                        }
                                        @if (material.LooseSections > 0)
                                        {
                                            <p>Loose sections: @material.LooseSections</p>
                                        }
                                        @if (material.Rolls > 0)
                                        {
                                            <p>Rolls: @material.Rolls</p>
                                        }
                                    </div>

                                    <button type="button"
                                            class="material-remove-button"
                                            @onclick="() => RemoveMaterialAsync(material.Id)">
                                        Remove
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

        </section>

        <!-- ADD MATERIAL -->

        <section class="projects-card">

            <div class="projects-card-heading">
                <div class="projects-icon">+</div>
                <div>
                    <h2>Add Material</h2>
                    <p>Add insulation material to your project.</p>
                </div>
            </div>

            <div class="projects-form">

                <label for="materialType">Material type</label>

                <select id="materialType"
                        class="projects-input"
                        @bind="materialType">

                    <option value="Pipe Sections">
                        Pipe Sections
                    </option>

                    <option value="Wired Mats">
                        Wired Mats
                    </option>

                    <option value="Lamella Mats">
                        Lamella Mats
                    </option>
                </select>

                <label for="materialDescription">
                    Description
                </label>

                <input id="materialDescription"
                       class="projects-input"
                       placeholder="e.g. Paroc 114/30"
                       @bind="materialDescription" />

                <label for="materialLength">
                    Length (m)
                </label>

                <input id="materialLength"
                       type="number"
                       min="0"
                       step="any"
                       class="projects-input"
                       @bind="materialLength" />

                <label for="materialDiameter">
                    Diameter (mm)
                </label>

                <input id="materialDiameter"
                       type="number"
                       min="0"
                       class="projects-input"
                       @bind="materialDiameter" />

                <label for="materialThickness">
                    Thickness (mm)
                </label>

                <input id="materialThickness"
                       type="number"
                       min="0"
                       class="projects-input"
                       @bind="materialThickness" />

                <label for="materialPackages">
                    Packages
                </label>

                <input id="materialPackages"
                       type="number"
                       min="0"
                       class="projects-input"
                       @bind="materialPackages" />

                <label for="materialLooseSections">
                    Loose sections
                </label>

                <input id="materialLooseSections"
                       type="number"
                       min="0"
                       class="projects-input"
                       @bind="materialLooseSections" />

                <label for="materialRolls">
                    Rolls
                </label>

                <input id="materialRolls"
                       type="number"
                       min="0"
                       class="projects-input"
                       @bind="materialRolls" />

                @if (!string.IsNullOrEmpty(materialError))
                {
                    <p class="projects-error">@materialError</p>
                }

                @if (!string.IsNullOrEmpty(materialSuccess))
                {
                    <p class="project-success">@materialSuccess</p>
                }

                <button class="projects-save-button"
                        @onclick="AddMaterialAsync">
                    Add Material
                </button>
            </div>

        </section>

        <!-- PROJECT INFORMATION -->

        <section class="projects-card">
            <h2>Project information</h2>

            <p class="project-info">
                Created:
                @project.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")
            </p>

            <p class="project-info">
                Last updated:
                @project.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd")
            </p>
        </section>

        <!-- DELETE PROJECT -->

        <section class="projects-card">
            <h2>Delete project</h2>

            <p class="project-info">
                Permanently remove this project.
            </p>

            @if (!showDeleteConfirmation)
            {
                <button class="project-delete-button"
                        @onclick="() => showDeleteConfirmation = true">
                    Delete Project
                </button>
            }
            else
            {
                <p class="projects-error">
                    Are you sure? This action cannot be undone.
                </p>

                <div class="project-detail-actions">
                    <button class="project-delete-button"
                            @onclick="DeleteProjectAsync">
                        Yes, Delete Project
                    </button>

                    <button class="project-secondary-button"
                            @onclick="() => showDeleteConfirmation = false">
                        Cancel
                    </button>
                </div>
            }
        </section>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Project? project;
    private bool isExportingPdf;
    private string pdfError = string.Empty;

    private string projectName = string.Empty;
    private string projectDescription = string.Empty;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private IEnumerable<IGrouping<string, ProjectMaterial>> MaterialGroups =>
        (project?.Materials ?? new List<ProjectMaterial>())
            .GroupBy(m => string.IsNullOrWhiteSpace(m.MaterialType) ? "Other" : m.MaterialType)
            .OrderBy(g => g.Key switch
            {
                "Pipe Sections" => 0,
                "Wired Mats" => 1,
                "Lamella Mats" => 2,
                _ => 3
            })
            .ThenBy(g => g.Key);

    private int ProjectMaterialCount => project?.Materials?.Count ?? 0;
    private double TotalMaterialLength => project?.Materials?.Sum(m => m.Length) ?? 0;
    private int TotalMaterialPackages => project?.Materials?.Sum(m => m.Packages) ?? 0;
    private int TotalMaterialLooseSections => project?.Materials?.Sum(m => m.LooseSections) ?? 0;
    private int TotalMaterialRolls => project?.Materials?.Sum(m => m.Rolls) ?? 0;

    private bool showDeleteConfirmation;

    private string materialType = "Pipe Sections";
    private string materialDescription = string.Empty;

    private double materialLength;
    private int materialDiameter;
    private int materialThickness;
    private int materialPackages;
    private int materialLooseSections;
    private int materialRolls;

    private string materialError = string.Empty;
    private string materialSuccess = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        project = await ProjectService.GetProjectByIdAsync(Id);

        if (project != null)
        {
            projectName = project.Name;
            projectDescription = project.Description;

            project.Materials ??= new List<ProjectMaterial>();
        }
    }

    private async Task UpdateProjectAsync()
    {
        if (project == null)
            return;

        errorMessage = string.Empty;
        successMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(projectName))
        {
            errorMessage = "Project name is required.";
            return;
        }

        project.Name = projectName.Trim();
        project.Description = projectDescription.Trim();
        project.UpdatedAt = DateTime.UtcNow;

        await ProjectService.SaveProjectAsync(project);

        successMessage = "Project updated successfully.";
    }

    private async Task AddMaterialAsync()
    {
        if (project == null)
            return;

        materialError = string.Empty;
        materialSuccess = string.Empty;

        if (string.IsNullOrWhiteSpace(materialDescription))
        {
            materialError = "Material description is required.";
            return;
        }

        if (materialLength <= 0 ||
            !double.IsFinite(materialLength))
        {
            materialError = "Length must be greater than zero.";
            return;
        }

        if (materialDiameter < 0 ||
            materialThickness < 0 ||
            materialPackages < 0 ||
            materialLooseSections < 0 ||
            materialRolls < 0)
        {
            materialError = "Quantities cannot be negative.";
            return;
        }

        var material = new ProjectMaterial
        {
            MaterialType = materialType,
            Description = materialDescription.Trim(),
            Length = materialLength,
            Diameter = materialDiameter,
            Thickness = materialThickness,
            Packages = materialPackages,
            LooseSections = materialLooseSections,
            Rolls = materialRolls
        };

        project.Materials ??= new List<ProjectMaterial>();
        project.Materials.Add(material);

        project.UpdatedAt = DateTime.UtcNow;

        await ProjectService.SaveProjectAsync(project);

        materialDescription = string.Empty;
        materialLength = 0;
        materialDiameter = 0;
        materialThickness = 0;
        materialPackages = 0;
        materialLooseSections = 0;
        materialRolls = 0;

        materialSuccess = "Material added successfully.";
    }

    private async Task RemoveMaterialAsync(Guid materialId)
    {
        if (project == null)
            return;

        var material = project.Materials?
            .FirstOrDefault(m => m.Id == materialId);

        if (material == null)
            return;

        project.Materials!.Remove(material);
        project.UpdatedAt = DateTime.UtcNow;

        await ProjectService.SaveProjectAsync(project);

        materialError = string.Empty;
        materialSuccess = "Material removed successfully.";
    }

    private async Task DeleteProjectAsync()
    {
        if (project == null)
            return;

        bool deleted =
            await ProjectService.DeleteProjectAsync(project.Id);

        if (deleted)
        {
            Navigation.NavigateTo("/projects");
        }
        else
        {
            errorMessage = "Could not delete the project.";
        }
    }

    private async Task ExportProjectPdfAsync()
    {
        if (project == null || isExportingPdf)
            return;

        pdfError = string.Empty;
        isExportingPdf = true;

        try
        {
            var pdfBytes = ProjectPdfService.GeneratePdf(project);
            using var stream = new MemoryStream(pdfBytes);
            using var streamReference = new DotNetStreamReference(stream);

            await JS.InvokeVoidAsync(
                "downloadFileFromStream",
                "InsulaCalc-Project-Report.pdf",
                streamReference);
        }
        catch (Exception)
        {
            pdfError = "Could not generate the PDF report. Please try again.";
        }
        finally
        {
            isExportingPdf = false;
        }
    }

    private void BackToProjects()
    {
        Navigation.NavigateTo("/projects");
    }
}
