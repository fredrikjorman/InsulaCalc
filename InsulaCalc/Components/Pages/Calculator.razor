@page "/calculator"
@rendermode InteractiveServer


@using Microsoft.JSInterop
@inject IJSRuntime JS
@using System.Text
@using InsulaCalc.Services
@using InsulaCalc.Models

<PageTitle>Insulation Calculator</PageTitle>

<div class="calculator-page">

    <div class="calculator-heading">
        <span class="calculator-label">SMART INSULATION PLANNING</span>
        <h1>Pipe Insulation Calculator</h1>
        <p>Enter your measurements to calculate the materials you need.</p>
    </div>

    <!-- Calculator Form -->

    <section class="calculator-card">

        <div class="calculator-card-header">
            <h2>Project measurements</h2>
            <p>Fill in the details of your pipe insulation project.</p>
        </div>

        <div class="row g-4">

            <div class="col-md-6">
                <label for="diameter" class="form-label">
                    Pipe diameter <span>(mm)</span>
                </label>

                <input type="number"
                       id="diameter"
                       class="form-control calculator-input"
                       min="1"
                       @bind="diameter" />
            </div>

            <div class="col-md-6">
                <label for="insulationThickness" class="form-label">
                    Insulation thickness <span>(mm)</span>
                </label>

                <input type="number"
                       id="insulationThickness"
                       class="form-control calculator-input"
                       min="1"
                       @bind="insulationThickness" />
            </div>

            <div class="col-md-6">
                <label for="requiredLength" class="form-label">
                    Required length <span>(m)</span>
                </label>

                <input type="number"
                       id="requiredLength"
                       class="form-control calculator-input"
                       min="0.1"
                       step="0.1"
                       @bind="requiredLength" />
            </div>

            <div class="col-md-6">
                <label for="sectionsPerPackage" class="form-label">
                    Sections per package <span>(pcs)</span>
                </label>

                <input type="number"
                       id="sectionsPerPackage"
                       class="form-control calculator-input"
                       min="1"
                       @bind="sectionsPerPackage" />
            </div>

        </div>

        <button type="button"
                class="calculate-button"
                @onclick="CalculatePipeSections">
            Calculate materials →
        </button>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3" role="alert">
                @errorMessage
            </div>
        }

    </section>

    <!-- Calculation Results -->
    @if (hasResult)
    {
        <section class="result-card mt-4">

            <div class="result-header">
                <div>
                    <h2>Calculation results</h2>
                    <p>Your estimated insulation requirements.</p>
                </div>
                <span class="result-status">Calculated</span>
            </div>

            <div class="row g-3">

                <div class="col-md-4">
                    <div class="result-item">
                        <span>Required sections</span>
                        <strong>@requiredPipeSections</strong>
                        <small>pipe sections</small>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="result-item">
                        <span>Full packages</span>
                        <strong>@fullPackages</strong>
                        <small>packages</small>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="result-item">
                        <span>Loose sections</span>
                        <strong>@loosePipeSections</strong>
                        <small>pipe sections</small>
                    </div>
                </div>

            </div>

            <button type="button"
                    class="add-material-button"
                    @onclick="AddMaterialItem">
                + Add to Material List
            </button>

        </section>
    }

    <!-- Material List -->

    <section class="material-section mt-5">

        <div class="material-header">

            <div class="material-heading">
                <div class="material-icon">▤</div>

                <div>
                    <h2>Your material list</h2>
                    <p>Everything you need, neatly organized.</p>
                </div>
            </div>

            <span class="material-count">
                @materialItems.Count materials
            </span>

        </div>

        @if (materialItems.Count == 0)
        {
            <div class="material-empty">
                <h3>No materials yet</h3>
                <p>Calculate your first pipe section and add it here.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table material-table align-middle">

                    <thead>
                        <tr>
                            <th>Material</th>
                            <th>Length</th>
                            <th>Packages</th>
                            <th>Loose</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in materialItems)
                        {
                            <tr @key="item.Id">

                                <td>
                                    <div class="material-name">
                                        Pipe @item.Diameter / @item.InsulationThickness
                                    </div>
                                    <div class="material-description">
                                        Pipe insulation
                                    </div>
                                </td>

                                <td>@item.RequiredLength m</td>

                                <td>
                                    <span class="package-number">
                                        @item.FullPackages
                                    </span>
                                </td>

                                <td>@item.LooseSections</td>

                                <td class="text-end">
                                    <button type="button"
                                            class="remove-button"
                                            aria-label="Remove pipe insulation material"
                                            @onclick="() => RemoveMaterialItem(item.Id)">
                                        Remove
                                    </button>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        }

        @if (materialItems.Count > 0)
        {
            <button type="button"
                    class="btn btn-primary mt-3"
                    @onclick="DownloadMaterialCsv">
                Export Material List
            </button>
        }


        <div class="material-footer">
            <span>Smart insulation planning</span>
            <span>InsulaCalc</span>
        </div>

    </section>

    <!-- Project Summary -->

    <section class="summary-section mt-4">

        <div class="summary-header">
            <h2>Project Summary</h2>
            <p>Overview of your insulation requirements.</p>
        </div>

        <div class="row g-3">

            <div class="col-md-6">
                <div class="summary-item">
                    <span>Total pipe length</span>
                    <strong>@TotalLength m</strong>
                </div>
            </div>

            <div class="col-md-6">
                <div class="summary-item">
                    <span>Required sections</span>
                    <strong>@TotalSections</strong>
                </div>
            </div>

            <div class="col-md-6">
                <div class="summary-item">
                    <span>Full packages</span>
                    <strong>@TotalPackages</strong>
                </div>
            </div>

            <div class="col-md-6">
                <div class="summary-item">
                    <span>Loose sections</span>
                    <strong>@TotalLooseSections</strong>
                </div>
            </div>

        </div>

    </section>

</div>

@code {

    private int diameter;
    private int insulationThickness;
    private decimal requiredLength;
    private int sectionsPerPackage = 3;

    private int requiredPipeSections;
    private int fullPackages;
    private int loosePipeSections;

    private PipeInsulationCalculator calculator = new();

    private string errorMessage = "";
    private bool hasResult = false;

    private List<MaterialItem> materialItems = new();

    private int calculatedDiameter;
    private int calculatedThickness;
    private decimal calculatedLength;
    private int calculatedPackageSize;

    private void CalculatePipeSections()
    {
        errorMessage = "";
        hasResult = false;

        if (diameter <= 0 ||
            insulationThickness <= 0 ||
            sectionsPerPackage <= 0 ||
            requiredLength <= 0)
        {
            errorMessage = "Please enter valid positive measurements and package size.";
            requiredPipeSections = 0;
            fullPackages = 0;
            loosePipeSections = 0;
            return;
        }

        requiredPipeSections =
            calculator.CalculateRequiredSections(requiredLength);

        fullPackages =
            calculator.CalculateFullPackages(requiredPipeSections, sectionsPerPackage);

        loosePipeSections =
            calculator.CalculateLooseSections(requiredPipeSections, sectionsPerPackage);

        calculatedDiameter = diameter;
        calculatedThickness = insulationThickness;
        calculatedLength = requiredLength;
        calculatedPackageSize = sectionsPerPackage;

        hasResult = true;
    }

    private void AddMaterialItem()
    {
        if (!hasResult)
        {
            return;
        }

        if (diameter != calculatedDiameter ||
            insulationThickness != calculatedThickness ||
            requiredLength != calculatedLength ||
            sectionsPerPackage != calculatedPackageSize)
        {
            errorMessage = "Inputs have changed. Please calculate again.";
            hasResult = false;
            return;
        }

        var item = new MaterialItem
        {
            Id = Guid.NewGuid(),
            Diameter = diameter,
            InsulationThickness = insulationThickness,
            RequiredLength = requiredLength,
            SectionsPerPackage = sectionsPerPackage,
            RequiredSections = requiredPipeSections,
            FullPackages = fullPackages,
            LooseSections = loosePipeSections
        };

        materialItems.Add(item);
        errorMessage = "";
    }

    private void RemoveMaterialItem(Guid id)
    {
        var item = materialItems.FirstOrDefault(x => x.Id == id);

        if (item != null)
        {
            materialItems.Remove(item);
        }
    }

    private decimal TotalLength =>
        materialItems.Sum(item => item.RequiredLength);

    private int TotalSections =>
        materialItems.Sum(item => item.RequiredSections);

    private int TotalPackages =>
        materialItems.Sum(item => item.FullPackages);

    private int TotalLooseSections =>
        materialItems.Sum(item => item.LooseSections);

        
    private string GenerateMaterialCsv()
    {
        var csv = new StringBuilder();

        csv.AppendLine("Material;Length (m);Required Sections;Packages;Loose Sections");

        foreach (var item in materialItems)
        {
            csv.AppendLine(
                $"Pipe {item.Diameter}/{item.InsulationThickness};" +
                $"{item.RequiredLength};" +
                $"{item.RequiredSections};" +
                $"{item.FullPackages};" +
                $"{item.LooseSections}");
        }

        return csv.ToString();
    }

    private async Task DownloadMaterialCsv()
    {
        if (materialItems.Count == 0)
        {
            return;
        }

        var csv = GenerateMaterialCsv();

        var bytes = Encoding.UTF8.GetBytes("\uFEFF" + csv);

        using var stream = new MemoryStream(bytes);
        using var streamReference = new DotNetStreamReference(stream);

        await JS.InvokeVoidAsync(
            "downloadFileFromStream",
            "InsulaCalc-MaterialList.csv",
            streamReference);
    }



}
