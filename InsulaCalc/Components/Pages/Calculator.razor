@page "/calculator"
@rendermode InteractiveServer
@using InsulaCalc.Services

<PageTitle>Insulation Calculator</PageTitle>

<h1>Insulation Calculator</h1>
<p>Calculate the amount of insulation needed for your project.</p>

<label for="diameter">Pipe diameter (mm)</label>
<input type="number" id="diameter" @bind="diameter" />
<p>Selected diameter: @diameter mm</p>

<label for="insulationThickness">Insulation thickness (mm)</label>
<input type="number" id="insulationThickness" @bind="insulationThickness" />
<p>Selected insulation thickness: @insulationThickness mm</p>

<label for="requiredLength">Required length (m)</label>
<input type="number" id="requiredLength" @bind="requiredLength" />
<p>Selected required length: @requiredLength m</p>

<label for="sectionsPerPackage">Pipe sections per package</label>
<input type="number" id="sectionsPerPackage" @bind="sectionsPerPackage" />

<button @onclick="CalculatePipeSections">Calculate</button>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="text-danger">@errorMessage</p>
}

@if (hasResult)
{
    <p>Required pipe sections: @requiredPipeSections pcs</p>
    <p>Full packages: @fullPackages</p>
    <p>Loose pipe sections: @loosePipeSections</p>
}

@code {
    private int diameter;
    private int insulationThickness;
    private decimal requiredLength;

    private int requiredPipeSections;
    private int fullPackages;
    private int loosePipeSections;
    private int sectionsPerPackage = 3;
    private PipeInsulationCalculator calculator = new();

    private string errorMessage = "";
    private bool hasResult = false;

    private void CalculatePipeSections()
    {
        errorMessage = "";
        hasResult = false;

        if (sectionsPerPackage <= 0 || requiredLength <= 0)
        {
            errorMessage = "Please enter a valid package size and length.";

            requiredPipeSections = 0;
            fullPackages = 0;
            loosePipeSections = 0;

            return;
        }

        requiredPipeSections = calculator.CalculateRequiredSections(requiredLength);

        fullPackages = calculator.CalculateFullPackages(requiredPipeSections, sectionsPerPackage);

        loosePipeSections = calculator.CalculateLooseSections(requiredPipeSections, sectionsPerPackage);

        hasResult = true;
    }
}
