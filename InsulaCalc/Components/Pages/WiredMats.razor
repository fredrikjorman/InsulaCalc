@page "/wired-mats"
@rendermode InteractiveServer
@using InsulaCalc.Services

<PageTitle>Wired Mats Calculator</PageTitle>

<div class="wired-page">

    <div class="wired-heading">
        <span class="wired-label">SMART INSULATION PLANNING</span>
        <h1>Wired Mats Calculator</h1>
        <p>Calculate the insulation area and rolls required for your project.</p>
    </div>

    <section class="wired-card">

        <div class="wired-card-header">
            <h2>Project measurements</h2>
            <p>Enter the measurements of your insulation project.</p>
        </div>

        <div class="row g-4">

            <div class="col-md-6">
                <label for="pipeDiameter" class="form-label">
                    Pipe diameter <span>(mm)</span>
                </label>
                <input id="pipeDiameter"
                       type="number"
                       min="1"
                       class="form-control wired-input"
                       @bind="pipeDiameter" />
            </div>

            <div class="col-md-6">
                <label for="insulationThickness" class="form-label">
                    Insulation thickness <span>(mm)</span>
                </label>
                <input id="insulationThickness"
                       type="number"
                       min="1"
                       class="form-control wired-input"
                       @bind="insulationThickness" />
            </div>

            <div class="col-md-6">
                <label for="pipeLength" class="form-label">
                    Pipe length <span>(m)</span>
                </label>
                <input id="pipeLength"
                       type="number"
                       min="0.1"
                       step="0.1"
                       class="form-control wired-input"
                       @bind="pipeLength" />
            </div>

            <div class="col-md-6">
                <label for="rollArea" class="form-label">
                    Roll area <span>(m²)</span>
                </label>
                <input id="rollArea"
                       type="number"
                       min="0.1"
                       step="0.1"
                       class="form-control wired-input"
                       @bind="rollArea" />
            </div>

        </div>

        <button type="button"
                class="wired-calculate-button"
                @onclick="Calculate">
            Calculate materials →
        </button>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3" role="alert">
                @errorMessage
            </div>
        }

    </section>

    @if (hasResult)
    {
        <section class="wired-result-card mt-4">

            <div class="wired-result-header">
                <div>
                    <h2>Calculation results</h2>
                    <p>Your estimated insulation requirements.</p>
                </div>
                <span class="wired-result-status">Calculated</span>
            </div>

            <div class="row g-3">

                <div class="col-md-6">
                    <div class="wired-result-item">
                        <span>Required area</span>
                        <strong>@requiredArea m²</strong>
                        <small>Insulation area</small>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="wired-result-item">
                        <span>Required rolls</span>
                        <strong>@requiredRolls</strong>
                        <small>Full rolls</small>
                    </div>
                </div>

            </div>

        </section>
    }

</div>

@code {
    private int pipeDiameter;
    private int insulationThickness;
    private decimal pipeLength;
    private decimal rollArea;

    private decimal requiredArea;
    private int requiredRolls;

    private bool hasResult;
    private string errorMessage = "";

    private readonly WiredMatCalculator calculator = new();

    private void Calculate()
    {
        hasResult = false;
        errorMessage = "";

        if (pipeDiameter <= 0 ||
            insulationThickness <= 0 ||
            pipeLength <= 0 ||
            rollArea <= 0)
        {
            errorMessage = "Please enter valid positive values.";
            return;
        }

        requiredArea = calculator.CalculateRequiredArea(
            pipeDiameter,
            insulationThickness,
            pipeLength);

        requiredRolls = calculator.CalculateRequiredRolls(
            requiredArea,
            rollArea);

        hasResult = true;
    }
}
