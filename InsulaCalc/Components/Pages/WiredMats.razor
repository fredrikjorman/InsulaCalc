@page "/wired-mats"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using InsulaCalc.Services
@using InsulaCalc.Models
@using System.Text
@using System.Globalization
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IProjectService ProjectService


<PageTitle>Wired Mats Calculator</PageTitle>

<div class="wired-page">

    <div class="wired-heading">
        <span class="wired-label">SMART INSULATION PLANNING</span>
        <h1>Wired Mats Calculator</h1>
        <p>Calculate the insulation area and rolls required for your project.</p>
    </div>

    <section class="wired-card">

        <div class="wired-card-header">
            <h2>Project measurements</h2>
            <p>Enter the measurements of your insulation project.</p>
        </div>

        <div class="row g-4">

            <div class="col-md-6">
                <label for="pipeDiameter" class="form-label">
                    Pipe diameter <span>(mm)</span>
                </label>
                <input id="pipeDiameter"
                       type="number"
                       min="1"
                       class="form-control wired-input"
                       @bind="pipeDiameter" />
            </div>

            <div class="col-md-6">
                <label for="insulationThickness" class="form-label">
                    Insulation thickness <span>(mm)</span>
                </label>
                <input id="insulationThickness"
                       type="number"
                       min="1"
                       class="form-control wired-input"
                       @bind="insulationThickness" />
            </div>

            <div class="col-md-6">
                <label for="pipeLength" class="form-label">
                    Pipe length <span>(m)</span>
                </label>
                <input id="pipeLength"
                       type="number"
                       min="0.1"
                       step="0.1"
                       class="form-control wired-input"
                       @bind="pipeLength" />
            </div>

            <div class="col-md-6">
                <label for="rollArea" class="form-label">
                    Roll area <span>(m²)</span>
                </label>
                <input id="rollArea"
                       type="number"
                       min="0.1"
                       step="0.1"
                       class="form-control wired-input"
                       @bind="rollArea" />
            </div>

        </div>

        <button type="button"
                class="wired-calculate-button"
                @onclick="Calculate">
            Calculate materials →
        </button>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3" role="alert">
                @errorMessage
            </div>
        }

    </section>

    @if (hasResult)
    {
        <section class="wired-result-card mt-4">

            <div class="wired-result-header">
                <div>
                    <h2>Calculation results</h2>
                    <p>Your estimated insulation requirements.</p>
                </div>
                <span class="wired-result-status">Calculated</span>
            </div>

            <div class="row g-3">

                <div class="col-md-6">
                    <div class="wired-result-item">
                        <span>Required area</span>
                        <strong>@requiredArea m²</strong>
                        <small>Insulation area</small>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="wired-result-item">
                        <span>Required rolls</span>
                        <strong>@requiredRolls</strong>
                        <small>Full rolls</small>
                    </div>
                </div>

            </div>

            <button type="button"
                    class="wired-add-button"
                    @onclick="AddMaterialItem">
                + Add to Material List
            </button>


        </section>
    }

    <!-- Wired Mats Material List -->

    <section class="wired-material-section mt-5">

        
        <div class="wired-material-header">
            <div class="wired-material-heading">
                <div class="wired-material-icon">▤</div>

                <div>
                    <h2>Your material list</h2>
                    <p>Everything you need, neatly organized.</p>
                </div>
            </div>


            <span class="wired-material-count">
                @materialItems.Count materials
            </span>
        </div>

        @if (materialItems.Count == 0)
        {
            <div class="wired-material-empty">
                <h3>No materials yet</h3>
                <p>Calculate your first wired mat and add it here.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table wired-material-table align-middle">

                    <thead>
                        <tr>
                            <th>Material</th>
                            <th>Length</th>
                            <th>Area</th>
                            <th>Rolls</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in materialItems)
                        {
                            <tr @key="item.Id">
                                <td>
                                    <div class="wired-material-name">
                                        Pipe @item.PipeDiameter / @item.InsulationThickness
                                    </div>
                                    <div class="wired-material-description">
                                        Wired mat insulation
                                    </div>
                                </td>

                                <td>@item.PipeLength m</td>
                                <td>@item.RequiredArea m²</td>
                                <td>
                                    <span class="wired-roll-number">
                                        @item.RequiredRolls
                                    </span>
                                </td>

                                <td class="text-end">
                                    <button type="button"
                                            class="wired-remove-button"
                                            @onclick="() => RemoveMaterialItem(item.Id)">
                                        Remove
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

        @if (materialItems.Count > 0)
        {
            <button type="button"
                    class="wired-export-button"
                    @onclick="DownloadMaterialCsv">
                Export Material List
            </button>
        }

        @if (materialItems.Count > 0)
        {
            <div class="wired-save-project-panel">
                <h3>Save to Project</h3>
                <p>Save your wired mat material list to an existing project.</p>

                @if (availableProjects.Count == 0)
                {
                    <p>No projects available. Create a project under My Projects first.</p>
                }
                else
                {
                    <label for="wiredProjectSelect">Select project</label>
                    <select id="wiredProjectSelect"
                            class="form-control wired-input"
                            @bind="selectedProjectId">
                        <option value="@Guid.Empty">Choose a project</option>
                        @foreach (var savedProject in availableProjects)
                        {
                            <option value="@savedProject.Id">@savedProject.Name</option>
                        }
                    </select>

                    <button type="button"
                            class="wired-save-project-button"
                            disabled="@isSavingProject"
                            @onclick="SaveMaterialsToProjectAsync">
                        @(isSavingProject ? "Saving..." : "Save to Project")
                    </button>
                }

                @if (!string.IsNullOrEmpty(projectSaveError))
                {
                    <p class="wired-save-error" role="alert">@projectSaveError</p>
                }
                @if (!string.IsNullOrEmpty(projectSaveSuccess))
                {
                    <p class="wired-save-success" role="status">@projectSaveSuccess</p>
                }
            </div>
        }

        <div class="wired-material-footer">
            <span>Smart insulation planning</span>
            <span>InsulaCalc</span>
        </div>

    </section>

    <!-- Project Summary -->

    <section class="wired-summary-section mt-4">

        <div class="wired-summary-header">
            <h2>Project Summary</h2>
            <p>Overview of your wired mat requirements.</p>
        </div>

        <div class="row g-3">

            <div class="col-md-4">
                <div class="wired-summary-item">
                    <span>Total pipe length</span>
                    <strong>@TotalPipeLength m</strong>
                </div>
            </div>

            <div class="col-md-4">
                <div class="wired-summary-item">
                    <span>Total required area</span>
                    <strong>@TotalRequiredArea m²</strong>
                </div>
            </div>

            <div class="col-md-4">
                <div class="wired-summary-item">
                    <span>Total required rolls</span>
                    <strong>@TotalRequiredRolls</strong>
                </div>
            </div>

        </div>

    </section>


</div>

@code {
    private List<Project> availableProjects = new();
    private Guid selectedProjectId = Guid.Empty;
    private bool isSavingProject;
    private string projectSaveError = string.Empty;
    private string projectSaveSuccess = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        availableProjects = (await ProjectService.GetAllProjectsAsync()).ToList();
    }

    private async Task SaveMaterialsToProjectAsync()
    {
        projectSaveError = string.Empty;
        projectSaveSuccess = string.Empty;

        if (isSavingProject) return;
        if (selectedProjectId == Guid.Empty)
        {
            projectSaveError = "Please select a project.";
            return;
        }
        if (materialItems.Count == 0)
        {
            projectSaveError = "Add materials to the list first.";
            return;
        }

        isSavingProject = true;
        try
        {
            // Load the latest version to preserve previously saved project materials.
            var target = await ProjectService.GetProjectByIdAsync(selectedProjectId);
            if (target == null)
            {
                projectSaveError = "Project not found. Please refresh and try again.";
                return;
            }

            target.Materials ??= new List<ProjectMaterial>();
            foreach (var item in materialItems)
            {
                target.Materials.Add(new ProjectMaterial
                {
                    MaterialType = "Wired Mats",
                    Description = $"Wired mat {item.PipeDiameter}/{item.InsulationThickness} · " +
                                  $"{item.RequiredArea.ToString(CultureInfo.InvariantCulture)} m² required area · " +
                                  $"{item.RollArea.ToString(CultureInfo.InvariantCulture)} m² per roll",
                    Diameter = item.PipeDiameter,
                    Thickness = item.InsulationThickness,
                    Length = (double)item.PipeLength,
                    Rolls = item.RequiredRolls
                });
            }

            target.UpdatedAt = DateTime.UtcNow;
            await ProjectService.SaveProjectAsync(target);
            projectSaveSuccess = $"Saved {materialItems.Count} material(s) to {target.Name}.";
        }
        catch (Exception)
        {
            projectSaveError = "Could not save materials. Please try again.";
        }
        finally
        {
            isSavingProject = false;
        }
    }

    private int pipeDiameter;
    private int insulationThickness;
    private decimal pipeLength;
    private decimal rollArea;

    private decimal requiredArea;
    private int requiredRolls;

    private bool hasResult;
    private string errorMessage = "";

    private readonly WiredMatCalculator calculator = new();
    private List<WiredMatItem> materialItems = new();

    private int calculatedDiameter;
    private int calculatedThickness;
    private decimal calculatedLength;
    private decimal calculatedRollArea;


    private void Calculate()
    {
        hasResult = false;
        errorMessage = "";

        if (pipeDiameter <= 0 ||
            insulationThickness <= 0 ||
            pipeLength <= 0 ||
            rollArea <= 0)
        {
            errorMessage = "Please enter valid positive values.";
            return;
        }

        requiredArea = calculator.CalculateRequiredArea(
            pipeDiameter,
            insulationThickness,
            pipeLength);

        
        requiredRolls = calculator.CalculateRequiredRolls(
            requiredArea,
            rollArea);

        calculatedDiameter = pipeDiameter;
        calculatedThickness = insulationThickness;
        calculatedLength = pipeLength;
        calculatedRollArea = rollArea;

        hasResult = true;

    }

    private void AddMaterialItem()

    {
        if (!hasResult)
        {
            return;
        }

        if (pipeDiameter != calculatedDiameter ||
            insulationThickness != calculatedThickness ||
            pipeLength != calculatedLength ||
            rollArea != calculatedRollArea)
        {
            errorMessage = "Inputs have changed. Please calculate again.";
            hasResult = false;
            return;
        }

        var item = new WiredMatItem
        {
            PipeDiameter = calculatedDiameter,
            InsulationThickness = calculatedThickness,
            PipeLength = calculatedLength,
            RollArea = calculatedRollArea,
            RequiredArea = requiredArea,
            RequiredRolls = requiredRolls
        };

        materialItems.Add(item);
        projectSaveSuccess = string.Empty;
        projectSaveError = string.Empty;

        errorMessage = "";
        hasResult = false;
    }


    private void RemoveMaterialItem(Guid id)
    {
        var item = materialItems.FirstOrDefault(x => x.Id == id);

        if (item != null)
        {
            materialItems.Remove(item);
            projectSaveSuccess = string.Empty;
            projectSaveError = string.Empty;
        }
    }

    private decimal TotalPipeLength =>
        materialItems.Sum(item => item.PipeLength);

    private decimal TotalRequiredArea =>
        materialItems.Sum(item => item.RequiredArea);

    private int TotalRequiredRolls =>
        materialItems.Sum(item => item.RequiredRolls);

        
    private string GenerateMaterialCsv()
    {
        var csv = new StringBuilder();

        csv.AppendLine("Material;Length (m);Roll Area (m2);Required Area (m2);Required Rolls");

        foreach (var item in materialItems)
        {
            csv.AppendLine(
                $"Pipe {item.PipeDiameter}/{item.InsulationThickness};" +
                $"{item.PipeLength.ToString(CultureInfo.InvariantCulture)};" +
                $"{item.RollArea.ToString(CultureInfo.InvariantCulture)};" +
                $"{item.RequiredArea.ToString(CultureInfo.InvariantCulture)};" +
                $"{item.RequiredRolls}");
        }

        return csv.ToString();
    }

    private async Task DownloadMaterialCsv()
    {
        if (materialItems.Count == 0)
        {
            return;
        }

        var csv = GenerateMaterialCsv();

        var bytes = Encoding.UTF8.GetBytes("\uFEFF" + csv);

        using var stream = new MemoryStream(bytes);
        using var streamReference = new DotNetStreamReference(stream);

        await JS.InvokeVoidAsync(
            "downloadFileFromStream",
            "InsulaCalc-WiredMats.csv",
            streamReference);
    }


}
