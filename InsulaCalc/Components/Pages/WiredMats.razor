@page "/wired-mats"
@rendermode InteractiveServer
@using InsulaCalc.Services

<PageTitle>Wired Mats Calculator</PageTitle>

<div class="container py-5">

    <h1>Wired Mats Calculator</h1>

    <p>Calculate how much wired mat insulation you need.</p>

    <div class="card p-4 mt-4">

        <h3>Project measurements</h3>

        <div class="row g-3 mt-2">

            <div class="col-md-6">
                <label class="form-label">Pipe diameter (mm)</label>
                <input type="number"
                       class="form-control"
                       @bind="pipeDiameter" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Insulation thickness (mm)</label>
                <input type="number"
                       class="form-control"
                       @bind="insulationThickness" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Pipe length (m)</label>
                <input type="number"
                       step="0.1"
                       class="form-control"
                       @bind="pipeLength" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Roll area (m²)</label>
                <input type="number"
                       step="0.1"
                       class="form-control"
                       @bind="rollArea" />
            </div>

        </div>

        <button class="btn btn-primary mt-4"
                @onclick="Calculate">
            Calculate materials
        </button>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3">
                @errorMessage
            </div>
        }

    </div>

    @if (hasResult)
    {
        <div class="card p-4 mt-4">

            <h3>Calculation results</h3>

            <div class="row mt-3">

                <div class="col-md-6">
                    <h5>Required area</h5>
                    <h2>@requiredArea m²</h2>
                </div>

                <div class="col-md-6">
                    <h5>Required rolls</h5>
                    <h2>@requiredRolls</h2>
                </div>

            </div>

        </div>
    }

</div>

@code {
    private int pipeDiameter;
    private int insulationThickness;
    private decimal pipeLength;
    private decimal rollArea;

    private decimal requiredArea;
    private int requiredRolls;

    private bool hasResult;
    private string errorMessage = "";

    private readonly WiredMatCalculator calculator = new();

    private void Calculate()
    {
        hasResult = false;
        errorMessage = "";

        if (pipeDiameter <= 0 ||
            insulationThickness <= 0 ||
            pipeLength <= 0 ||
            rollArea <= 0)
        {
            errorMessage = "Please enter valid positive values.";
            return;
        }

        requiredArea = calculator.CalculateRequiredArea(
            pipeDiameter,
            insulationThickness,
            pipeLength);

        requiredRolls = calculator.CalculateRequiredRolls(
            requiredArea,
            rollArea);

        hasResult = true;
    }
}
