@page "/"

<PageTitle>InsulaCalc - Home</PageTitle>

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-4">

            <!-- Left side: Welcome text -->
            <div class="col-lg-6">

                <span class="hero-label">
                    SMART INSULATION PLANNING
                </span>

                <h1 class="display-5 fw-bold hero-title mt-3">
                    Technical insulation, made simple.
                </h1>

                <p class="lead text-muted mt-3">
                    Calculate insulation materials, plan your projects
                    and get accurate quantities in seconds.
                </p>

                <a href="/calculator"
                   class="btn btn-primary btn-lg mt-3 hero-button">
                    Start Calculating →
                </a>

            </div>

            <!-- Right side: 3D illustration -->
            <div class="col-lg-6">

                <div class="hero-image-container">
                    <img src="/images/insula-hero.png"
                         alt="3D illustration of technical pipe insulation"
                         class="hero-image" />
                </div>

            </div>

        </div>
    </div>
</section>

<!-- Material Categories -->
<section class="container categories-section">

    <h2 class="mb-4">
        What would you like to calculate?
    </h2>

    <div class="row g-4">

        <!-- Pipe Sections -->
        <div class="col-md-4">
            <div class="card h-100 material-card">
                <div class="card-body">

                    <h3 class="card-title h5">
                        Pipe Sections
                    </h3>

                    <p class="card-text text-muted">
                        Calculate pipe insulation quantities
                        and package requirements.
                    </p>

                    <a href="/calculator"
                       class="btn btn-outline-primary">
                        Calculate →
                    </a>

                </div>
            </div>
        </div>

        <!-- Wired Mats -->
        <div class="col-md-4">
            <div class="card h-100 material-card">
                <div class="card-body">

                    <h3 class="card-title h5">
                        Wired Mats
                    </h3>

                    <p class="card-text text-muted">
                        Calculate insulation rolls
                        based on required area.
                    </p>

                    
                    
                    <a href="/wired-mats" class="btn btn-outline-primary">
                        Calculate →
                    </a>



                </div>
            </div>
        </div>

        <!-- Lamella Mats -->
        <div class="col-md-4">
            <div class="card h-100 material-card">
                <div class="card-body">

                    <h3 class="card-title h5">
                        Lamella Mats
                    </h3>

                    <p class="card-text text-muted">
                        Calculate lamella mat rolls
                        for your project.
                    </p>

                    <span class="badge bg-secondary">
                        Coming Soon
                    </span>

                </div>
            </div>
        </div>

    </div>
</section>
