@page "/"

<PageTitle>InsulaCalc - Home</PageTitle>

<section class="py-5">

    <div class="container">

        <h1 class="display-4 fw-bold">
            Technical insulation, made simple.
        </h1>

        <p class="lead text-muted mt-3">
            Calculate insulation materials, plan your projects
            and get accurate quantities in seconds.
        </p>

        <a href="/calculator" class="btn btn-primary btn-lg mt-3">
            Start Calculating →
        </a>

    </div>

</section>


<section class="container mt-4">

    <h2 class="mb-4">What would you like to calculate?</h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="card-title h5">Pipe Sections</h3>

                    <p class="card-text text-muted">
                        Calculate pipe insulation quantities
                        and package requirements.
                    </p>

                    <a href="/calculator" class="btn btn-outline-primary">
                        Calculate →
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="card-title h5">Wired Mats</h3>

                    <p class="card-text text-muted">
                        Calculate insulation rolls
                        based on required area.
                    </p>

                    <span class="badge bg-secondary">Coming Soon</span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="card-title h5">Lamella Mats</h3>

                    <p class="card-text text-muted">
                        Calculate lamella mat rolls
                        for your project.
                    </p>

                    <span class="badge bg-secondary">Coming Soon</span>
                </div>
            </div>
        </div>

    </div>

</section>

