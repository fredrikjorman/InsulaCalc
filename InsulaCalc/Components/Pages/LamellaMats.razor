@page "/lamella-mats"
@rendermode InteractiveServer

@using InsulaCalc.Models
@using InsulaCalc.Services
@using System.Text
@using System.Globalization
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject ProjectService ProjectService


<PageTitle>Lamella Mats | InsulaCalc</PageTitle>


<div class="lamella-page">

    <div class="lamella-header">

        <div class="lamella-eyebrow">
            SMART INSULATION PLANNING
        </div>

        <h1>Lamella Mats Calculator</h1>

        <p>
            Calculate insulation materials for round pipes
            and ventilation ducts.
        </p>

    </div>


    
    <div class="lamella-calculator">

        <h2>Project measurements</h2>
        <p class="lamella-form-description">
            Enter the measurements of your insulation project.
        </p>

        <div class="row g-4">

            <div class="col-md-6">
                <label class="form-label">Pipe diameter (mm)</label>
                <InputNumber @bind-Value="calculation.PipeDiameter"
                             class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Insulation thickness (mm)</label>
                <InputNumber @bind-Value="calculation.InsulationThickness"
                             class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Pipe length (m)</label>
                <InputNumber @bind-Value="calculation.PipeLength"
                             class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Roll area (m²)</label>
                <InputNumber @bind-Value="calculation.RollArea"
                             class="form-control" />
            </div>

        </div>


        <button class="btn btn-primary"
                @onclick="Calculate">
            Calculate Materials
        </button>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3">
                @errorMessage
            </div>
        }

       
        @if (hasResult)
        {
            <section class="lamella-result mt-4">

                <div class="lamella-result-header">
                    <div>
                        <h2>Calculation results</h2>
                        <p>Your estimated insulation requirements.</p>
                    </div>

                    <span class="lamella-result-status">
                        Calculated
                    </span>
                </div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <div class="lamella-result-item">
                            <span>Required area</span>
                            <strong>@requiredArea m²</strong>
                            <small>Insulation area</small>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="lamella-result-item">
                            <span>Required rolls</span>
                            <strong>@requiredRolls</strong>
                            <small>Full rolls</small>
                        </div>
                    </div>

                </div>

                <button type="button"
                        class="lamella-add-button"
                        @onclick="AddMaterialItem">
                    + Add to Material List
                </button>

            </section>
        }

        

    </div>

    <!-- MATERIAL LIST -->

    <section class="lamella-material-section mt-5">

        
        <div class="lamella-material-header">
            <div class="lamella-material-heading">
                <div class="lamella-material-icon">▤</div>

                <div>
                    <h2>Your material list</h2>
                    <p>Everything you need, neatly organized.</p>
                </div>
            </div>


            <span class="lamella-material-count">
                @materialItems.Count materials
            </span>
        </div>

        @if (materialItems.Count == 0)
        {

            <div class="lamella-empty-state">
                <h3>No materials yet</h3>
                <p>Calculate your first lamella mat and add it here.</p>
            </div>

        }
        else
        {
            <div class="table-responsive">
                <table class="table lamella-material-table align-middle">
                    <thead>
                        <tr>
                            <th>Material</th>
                            <th>Length</th>
                            <th>Area</th>
                            <th>Rolls</th>
                            <th>Remove</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in materialItems)
                        {
                            <tr @key="item.Id">
                                <td>
                                    Pipe @item.PipeDiameter / @item.InsulationThickness
                                </td>

                                <td>@item.PipeLength m</td>

                                <td>@item.RequiredArea m²</td>

                                <td>@item.RequiredRolls</td>

                                <td>
                                    <button class="lamella-remove-button"
                                            @onclick="() => RemoveMaterialItem(item.Id)">
                                        Remove
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (materialItems.Count > 0)
        {
            <button type="button"
                    class="lamella-export-button"
                    @onclick="DownloadMaterialCsv">
                Export Material List
            </button>
        }

        @if (materialItems.Count > 0)
        {
            <div class="lamella-save-project-panel">
                <h3>Save to Project</h3>
                <p>Save all lamella mat materials in this list to an existing project.</p>

                @if (availableProjects.Count == 0)
                {
                    <p>No projects available. Create a project under My Projects first.</p>
                }
                else
                {
                    <label for="lamellaProjectSelect">Select project</label>
                    <select id="lamellaProjectSelect" class="form-control"
                            @bind="selectedProjectId">
                        <option value="@Guid.Empty">Choose a project</option>
                        @foreach (var savedProject in availableProjects)
                        {
                            <option value="@savedProject.Id">@savedProject.Name</option>
                        }
                    </select>
                    <button type="button" class="btn btn-primary"
                            disabled="@isSavingProject"
                            @onclick="SaveMaterialsToProjectAsync">
                        @(isSavingProject ? "Saving..." : "Save to Project")
                    </button>
                }

                @if (!string.IsNullOrEmpty(projectSaveError))
                {
                    <p class="text-danger mt-2" role="alert">@projectSaveError</p>
                }
                @if (!string.IsNullOrEmpty(projectSaveSuccess))
                {
                    <p class="text-success mt-2" role="status">@projectSaveSuccess</p>
                }
            </div>
        }

        <div class="lamella-material-footer">
            <span>Smart insulation planning</span>
            <span>InsulaCalc</span>
        </div>

    </section>

    
    <!-- PROJECT SUMMARY -->

    <section class="lamella-summary-section mt-4">

        <div class="lamella-summary-header">
            <h2>Project Summary</h2>
            <p>Overview of your lamella mat requirements.</p>
        </div>

        <div class="row g-3">

            <div class="col-md-4">
                <div class="lamella-summary-item">
                    <span>Total pipe length</span>
                    <strong>@TotalPipeLength m</strong>
                </div>
            </div>

            <div class="col-md-4">
                <div class="lamella-summary-item">
                    <span>Total required area</span>
                    <strong>@TotalRequiredArea m²</strong>
                </div>
            </div>

            <div class="col-md-4">
                <div class="lamella-summary-item">
                    <span>Total required rolls</span>
                    <strong>@TotalRequiredRolls</strong>
                </div>
            </div>

        </div>

    </section>

</div>


@code {
    private List<Project> availableProjects = new();
    private Guid selectedProjectId = Guid.Empty;
    private bool isSavingProject;
    private string projectSaveError = string.Empty;
    private string projectSaveSuccess = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        availableProjects = await ProjectService.GetAllProjectsAsync();
    }

    private async Task SaveMaterialsToProjectAsync()
    {
        projectSaveError = string.Empty;
        projectSaveSuccess = string.Empty;

        if (isSavingProject) return;
        if (selectedProjectId == Guid.Empty)
        {
            projectSaveError = "Please select a project.";
            return;
        }
        if (materialItems.Count == 0)
        {
            projectSaveError = "Add materials to the list first.";
            return;
        }

        isSavingProject = true;
        try
        {
            var target = await ProjectService.GetProjectByIdAsync(selectedProjectId);
            if (target is null)
            {
                projectSaveError = "Project not found. Please refresh and try again.";
                return;
            }

            target.Materials ??= new List<ProjectMaterial>();
            foreach (var item in materialItems)
            {
                target.Materials.Add(new ProjectMaterial
                {
                    MaterialType = "Lamella Mats",
                    Description = $"Lamella mat {item.PipeDiameter}/{item.InsulationThickness} · " +
                                  $"{item.RequiredArea.ToString(CultureInfo.InvariantCulture)} m² required area · " +
                                  $"{item.RollArea.ToString(CultureInfo.InvariantCulture)} m² per roll",
                    Diameter = item.PipeDiameter,
                    Thickness = item.InsulationThickness,
                    Length = (double)item.PipeLength,
                    Rolls = item.RequiredRolls
                });
            }

            target.UpdatedAt = DateTime.UtcNow;
            await ProjectService.SaveProjectAsync(target);
            projectSaveSuccess = $"Saved {materialItems.Count} material(s) to {target.Name}.";
        }
        catch (Exception)
        {
            projectSaveError = "Could not save materials. Please try again.";
        }
        finally
        {
            isSavingProject = false;
        }
    }

    private LamellaMatCalculation calculation = new();

    private LamellaMatCalculator calculator = new();

    private decimal requiredArea;
    private int requiredRolls;
    private bool hasResult = false;
    private string? errorMessage;

    private List<LamellaMatItem> materialItems = new();

    private int calculatedDiameter;
    private int calculatedThickness;
    private decimal calculatedLength;
    private decimal calculatedRollArea;


    
    private void Calculate()
    {
        hasResult = false;

        try
        {
            requiredArea = calculator.CalculateRequiredArea(
                calculation.PipeDiameter,
                calculation.InsulationThickness,
                calculation.PipeLength);

            requiredRolls = calculator.CalculateRequiredRolls(
                requiredArea,
                calculation.RollArea);

            calculatedDiameter = calculation.PipeDiameter;
            calculatedThickness = calculation.InsulationThickness;
            calculatedLength = calculation.PipeLength;
            calculatedRollArea = calculation.RollArea;

            errorMessage = null;
            hasResult = true;
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void AddMaterialItem()
    {
        if (!hasResult)
            return;

        if (calculation.PipeDiameter != calculatedDiameter ||
            calculation.InsulationThickness != calculatedThickness ||
            calculation.PipeLength != calculatedLength ||
            calculation.RollArea != calculatedRollArea)
        {
            errorMessage = "Inputs have changed. Please calculate again.";
            hasResult = false;
            return;
        }

        var item = new LamellaMatItem
        {
            PipeDiameter = calculatedDiameter,
            InsulationThickness = calculatedThickness,
            PipeLength = calculatedLength,
            RollArea = calculatedRollArea,
            RequiredArea = requiredArea,
            RequiredRolls = requiredRolls
        };

        materialItems.Add(item);
        projectSaveSuccess = string.Empty;
        projectSaveError = string.Empty;

        hasResult = false;
        errorMessage = null;
    }

    private void RemoveMaterialItem(Guid id)
    {
        var item = materialItems.FirstOrDefault(x => x.Id == id);

        if (item != null)
        {
            materialItems.Remove(item);
            projectSaveSuccess = string.Empty;
        }
    }

    private decimal TotalPipeLength =>
        materialItems.Sum(item => item.PipeLength);

    private decimal TotalRequiredArea =>
        materialItems.Sum(item => item.RequiredArea);

    private int TotalRequiredRolls =>
        materialItems.Sum(item => item.RequiredRolls);

        
    private string GenerateMaterialCsv()
    {
        var csv = new StringBuilder();

        csv.AppendLine("Material;Length (m);Roll Area (m2);Required Area (m2);Required Rolls");

        foreach (var item in materialItems)
        {
            csv.AppendLine(
                $"Pipe {item.PipeDiameter}/{item.InsulationThickness};" +
                $"{item.PipeLength.ToString(CultureInfo.InvariantCulture)};" +
                $"{item.RollArea.ToString(CultureInfo.InvariantCulture)};" +
                $"{item.RequiredArea.ToString(CultureInfo.InvariantCulture)};" +
                $"{item.RequiredRolls}");
        }

        return csv.ToString();
    }

    private async Task DownloadMaterialCsv()
    {
        if (materialItems.Count == 0)
        {
            return;
        }

        var csv = GenerateMaterialCsv();

        var bytes = Encoding.UTF8.GetBytes("\uFEFF" + csv);

        using var stream = new MemoryStream(bytes);
        using var streamReference = new DotNetStreamReference(stream);

        await JS.InvokeVoidAsync(
            "downloadFileFromStream",
            "InsulaCalc-LamellaMats.csv",
            streamReference);
    }



}

